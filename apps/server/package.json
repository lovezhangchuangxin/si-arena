{
  "name": "@si-arena/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch ../../scripts/dev-entry.ts",
    "build": "tsdown --config ../../tsdown.config.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --configLoader runner --config ../../vitest.config.ts --project server"
  },
  "dependencies": {
    "@si-arena/db": "workspace:*",
    "@si-arena/development": "workspace:*",
    "@si-arena/game-bomber": "workspace:*",
    "@si-arena/game-cube": "workspace:*",
    "@si-arena/game-danmaku": "workspace:*",
    "@si-arena/game-paper": "workspace:*",
    "@si-arena/game-royale": "workspace:*",
    "@si-arena/game-snake": "workspace:*",
    "@si-arena/game-tank": "workspace:*",
    "@si-arena/game-tetris": "workspace:*",
    "@si-arena/protocol": "workspace:*",
    "@si-arena/runner": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
