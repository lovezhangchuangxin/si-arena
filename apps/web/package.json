{
  "name": "@si-arena/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx ../../scripts/wait-for-workspace-deps.ts && vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --configLoader runner --config ../../vitest.config.ts --project web",
    "typecheck:test": "vue-tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "catalog:",
    "@fontsource/jetbrains-mono": "catalog:",
    "@si-arena/game-bomber": "workspace:*",
    "@si-arena/game-cube": "workspace:*",
    "@si-arena/game-danmaku": "workspace:*",
    "@si-arena/game-paper": "workspace:*",
    "@si-arena/game-royale": "workspace:*",
    "@si-arena/game-snake": "workspace:*",
    "@si-arena/game-tank": "workspace:*",
    "@si-arena/game-tetris": "workspace:*",
    "@si-arena/player": "workspace:*",
    "@si-arena/protocol": "workspace:*",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
