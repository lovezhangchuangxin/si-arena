API_HOST=127.0.0.1
API_PORT=3000
# 网页 dev server 的监听地址；设为 0.0.0.0 可在局域网访问（不影响 API 监听）
# WEB_HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://si_arena:si_arena@127.0.0.1:5433/si_arena
WORKER_CONCURRENCY=2
# server 与 worker 共用的回放根目录；相对路径以仓库根目录为基准
REPLAYS_DIR=data/replays
# 已生成的不可变开发包目录，相对路径以仓库根目录为基准
DEVKITS_DIR=data/releases
# 私有 Boss 代码目录：每个游戏一个 <gameId>.js，不存在则关闭该游戏的 Boss 挑战
BOSSES_DIR=data/bosses
# 比赛执行进程隔离：local（默认）或 cgroup-v2（Linux 线上部署）
# WORKER_ISOLATION=cgroup-v2
# cgroup-v2 时必填：已委托的绝对 cgroup 目录
# WORKER_CGROUP_ROOT=/sys/fs/cgroup/si-arena
