{
  "extends": "./base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "paths": {
      "@si-arena/player/browser": ["../../packages/player/src/browser/index.ts"],
      "@si-arena/engine/node": ["../../packages/engine/src/node/index.ts"],
      "@si-arena/game-*/game": ["../../games/*/src/game.ts"],
      "@si-arena/game-*/sdk": ["../../games/*/src/sdk/index.ts"],
      "@si-arena/game-*/rules": ["../../games/*/src/rules/index.ts"],
      "@si-arena/game-*/renderer": ["../../games/*/src/renderer/index.ts"],
      "@si-arena/game-*": ["../../games/*/src/index.ts"],
      "@si-arena/*": ["../../packages/*/src/index.ts"]
    }
  },
  "include": [
    "../../apps/*/tests/**/*.ts",
    "../../packages/*/tests/**/*.ts",
    "../../games/*/tests/**/*.ts",
    "../../apps/*/vitest*.config.ts",
    "../../packages/*/vitest*.config.ts",
    "../../games/*/vitest*.config.ts"
  ],
  "exclude": [
    "../../apps/web/tests/**",
    "../../packages/player/tests/**",
    "../../games/paper/tests/**",
    "../../games/royale/tests/**",
    "../../games/snake/tests/**",
    "../../games/bomber/tests/**",
    "../../games/cube/tests/**",
    "../../games/tank/tests/**",
    "../../games/tetris/tests/**",
    "../../games/danmaku/tests/**"
  ]
}
