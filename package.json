{
  "name": "si-arena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:devkits": "pnpm build:packages && node --import tsx scripts/build-devkits.ts",
    "dev": "pnpm build:packages && pnpm -r --parallel run dev",
    "dev:web": "pnpm build:packages && pnpm --filter @si-arena/web dev",
    "dev:server": "pnpm build:packages && pnpm --filter @si-arena/server dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @si-arena/worker dev",
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --filter './packages/**' --filter './games/**' run build",
    "typecheck": "pnpm build:packages && tsc -p configs/typescript/tooling.json --noEmit && tsc -p configs/typescript/test.json --noEmit && pnpm -r run typecheck && pnpm --filter @si-arena/web typecheck:test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --configLoader runner",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "arena": "node packages/cli/dist/main.js --registry ./configs/arena.local.mjs",
    "db:generate": "pnpm --filter @si-arena/db db:generate",
    "db:migrate": "pnpm --filter @si-arena/db db:migrate",
    "prepare": "simple-git-hooks",
    "test:watch": "vitest --watch --configLoader runner",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:artifacts": "pnpm build && node --import tsx scripts/verify-artifacts.ts && node --import tsx scripts/verify-devkits.ts",
    "example:paper": "pnpm build:packages && node scripts/example-paper.mjs",
    "publish:packages": "node --import tsx scripts/publish.ts",
    "bench:runner": "pnpm build:packages && node scripts/benchmark-runner.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@si-arena/cli": "workspace:*",
    "@si-arena/development": "workspace:*",
    "@si-arena/engine": "workspace:*",
    "@si-arena/game-bomber": "workspace:*",
    "@si-arena/game-cube": "workspace:*",
    "@si-arena/game-danmaku": "workspace:*",
    "@si-arena/game-paper": "workspace:*",
    "@si-arena/game-royale": "workspace:*",
    "@si-arena/game-snake": "workspace:*",
    "@si-arena/game-tank": "workspace:*",
    "@si-arena/game-tetris": "workspace:*",
    "@si-arena/protocol": "workspace:*",
    "@si-arena/runner": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fflate": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "simple-git-hooks": "catalog:",
    "tar": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,vue}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,yaml,yml,css,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.14.0"
}
